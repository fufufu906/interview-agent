# Public-demo entrypoint does NOT read backend/.env. Configure these in your host.
# Start: uvicorn mianshi_agent.public_demo:app --host 0.0.0.0 --port 8000 --workers 1
DEMO_PUBLIC_ORIGIN=https://replace-with-platform-host.example
DEMO_ALLOW_HTTP_LOCAL=false
DEMO_DATA_DIR=/app/data/public-demo
DEMO_SESSION_SECONDS=86400
DEMO_KEY_SECONDS=1800
DEMO_MAX_VISITORS=30
DEMO_MAX_ACTIVE=4
DEMO_EMBEDDING_BASE_URL=http://interview-agent-ollama:11434
DEMO_EMBEDDING_MODEL=qwen3-embedding:0.6b
DEMO_EMBEDDING_DIMENSIONS=1024
# No shared LLM_API_KEY. Each visitor attaches their own DeepSeek key in the UI.
