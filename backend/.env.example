# Application
APP_DATA_DIR=../data/runtime
APP_DATABASE_PATH=../data/runtime/mianshiagent.sqlite3
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_MAX_UPLOAD_BYTES=15728640

# OpenAI-compatible chat model. Fill these with your own provider settings.
# This template contains no real credentials or private provider endpoint.
LLM_PROVIDER=custom
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL_ID=your-chat-model
LLM_TIMEOUT=90

# Local Ollama embedding baseline.
MEMORY_EMBEDDING_MODEL=qwen3-embedding:0.6b
MEMORY_EMBEDDING_DIMENSIONS=1024
MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:11434
MEMORY_EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT=120

# Retrieval
RETRIEVAL_VECTOR_LIMIT=12
RETRIEVAL_LEXICAL_LIMIT=12
RETRIEVAL_RRF_K=60
RETRIEVAL_MAX_GRAPH_HOPS=2
RETRIEVAL_MAX_GRAPH_NODES=30
